    {
      "id": "R-REVIEW-PERSIST",
      "等级": "人工复核",
      "条件": {"数值不小于": {"症状持续小时": 48}},
      "理由": "症状持续48小时未缓解需人工评估。"
    },
    {
      "id": "R-HOME-MILD",
      "等级": "居家观察",
      "条件": {"事实包含任一": ["线状红斑", "片状红斑", "灼痛", "瘙痒"]},
      "理由": "仅有局限红斑或轻度灼痛瘙痒、无危险信号时，冲洗后可居家观察。"

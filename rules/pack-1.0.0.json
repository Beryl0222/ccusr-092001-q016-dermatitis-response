    {
      "id": "R-EMERG-BLISTER-FACE",
      "等级": "尽快就医",
      "条件": {"事实包含任一": ["水疱"], "部位包含任一": ["面颈", "会阴"]},
      "理由": "面颈或会阴部位水疱有累及眼、黏膜风险，需尽快就医。"
    },
    {
      "id": "R-EMERG-FEVER",
      "等级": "尽快就医",

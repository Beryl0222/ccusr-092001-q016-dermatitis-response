    },
    {
      "id": "R-EMERG-LARGE-AREA",
      "等级": "尽快就医",
      "条件": {"数值不小于": {"范围占体表面积百分比": 10}},
      "理由": "皮损范围达到或超过体表面积10%，按大面积反应处置。"
    },
    {
      "id": "R-REVIEW-LARGE-REDNESS",
      "等级": "人工复核",
      "条件": {"事实包含任一": ["大面积红斑"]},
      "理由": "大面积红斑为危险信号，资料不足以判定范围时由人工坐席复核。"
    },
    {
      "id": "R-REVIEW-BLISTER",
      "等级": "人工复核",
      "条件": {"事实包含任一": ["水疱"]},
      "理由": "水疱为危险信号，需人工确认部位、面积后决定是否线下就医。"
